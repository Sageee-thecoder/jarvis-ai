# ---------- Brain: Google Gemini ----------
GEMINI_API_KEY=
JARVIS_MODEL=gemini-3.5-flash

# ---------- Identity ----------
ASSISTANT_NAME=J.A.R.V.I.S.
OWNER_NAME=

# ---------- Server ----------
HOST=127.0.0.1
PORT=5000

# ---------- Email (Jarvis's own mailbox -> YOUR inbox) ----------
# Gmail rejects the normal account password over SMTP. Turn on 2-Step Verification
# for this account, create an "App password", and paste it into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=

# ---------- WhatsApp (whatsapp-web.js bridge) ----------
# Your own number, digits only with country code, e.g. 905551234567
OWNER_WHATSAPP=
BRIDGE_URL=http://127.0.0.1:3917
BRIDGE_PORT=3917
# Generate a random hex string for BRIDGE_TOKEN
BRIDGE_TOKEN=
JARVIS_URL=http://127.0.0.1:5000

# ---------- Telegram (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Speed ----------
# minimal = fastest replies. Options: minimal, low, medium, high (Gemini 3.x models only)
JARVIS_THINKING=minimal

# ---------- Weather (OpenWeather) ----------
OPENWEATHER_API_KEY=
# City name, e.g. London or Istanbul
WEATHER_CITY=
WEATHER_UNITS=metric
WEATHER_LANG=en
WEATHER_REFRESH_MIN=10
WEATHER_TEMP_ALERT=5

# ---------- WiZ smart lights ----------
# Comma-separated list. "Name=IP" pairs are best, so you can say "turn off the bedroom".
# Several bulbs that act as ONE light are joined with | (they always switch together).
# Give each bulb a fixed IP in your router (DHCP reservation) so these never change.
# Example: Bedroom=192.168.1.50,LivingRoom=192.168.1.51|192.168.1.52
WIZ_LIGHTS=
WIZ_TIMEOUT=4

# ---------- Read-only access to YOUR OWN inbox (IMAP) ----------
# Gmail: turn on 2-Step Verification, create an App Password, paste it into IMAP_PASS.
# Outlook/Hotmail personal accounts no longer allow this; tell me if that is your provider.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
MAIL_POLL_SEC=120

# ---------- WhatsApp mode ----------
# self = the bridge is linked to YOUR OWN WhatsApp (needed to read your chats)
# assistant = the bridge is linked to a separate spare account that only Jarvis uses
WA_MODE=self
WA_ANNOUNCE_GROUPS=false
