# ---------------------------------------------------------------------------
# J.A.R.V.I.S. configuration
# Copy this file to .env and fill in your own values. Never commit .env.
# ---------------------------------------------------------------------------

# ---------- Brain: Google Gemini ----------
GEMINI_API_KEY=
JARVIS_MODEL=gemini-3.5-flash

# ---------- Identity ----------
ASSISTANT_NAME=J.A.R.V.I.S.
OWNER_NAME=

# ---------- Server ----------
HOST=127.0.0.1
PORT=5000
# Generate a long random string; the Android app must send this on the LAN.
PHONE_TOKEN=

# ---------- Email (the assistant's own mailbox sends TO the owner) ----------
# Gmail rejects the normal account password over SMTP. Enable 2-Step
# Verification, create an App Password, and put it in SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
OWNER_EMAIL=

# ---------- WhatsApp (whatsapp-web.js bridge) ----------
# Your own number, digits only with country code, e.g. 905550000000
OWNER_WHATSAPP=
BRIDGE_URL=http://127.0.0.1:3917
BRIDGE_PORT=3917
# Generate a random hex string.
BRIDGE_TOKEN=
JARVIS_URL=http://127.0.0.1:5000

# ---------- Telegram (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------- Speed ----------
# minimal = fastest replies. Options: minimal, low, medium, high.
JARVIS_THINKING=minimal

# ---------- Weather (OpenWeather) ----------
OPENWEATHER_API_KEY=
# City,CountryCode - for example Istanbul,TR
WEATHER_CITY=Istanbul,TR
WEATHER_UNITS=metric
WEATHER_LANG=en
WEATHER_REFRESH_MIN=10
WEATHER_TEMP_ALERT=5

# ---------- WiZ smart lights ----------
# Comma-separated Name=IP pairs, for example:
# WIZ_LIGHTS=LivingRoom=192.168.1.50,Bedroom=192.168.1.51
# Bulbs that act as one light are joined with | (they switch together).
WIZ_LIGHTS=
WIZ_TIMEOUT=4

# ---------- Read-only access to YOUR OWN inbox (IMAP) ----------
# Gmail: enable 2-Step Verification, create an App Password, and put it in IMAP_PASS.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
MAIL_POLL_SEC=120

# ---------- WhatsApp mode ----------
# self = linked to YOUR OWN WhatsApp (needed to read your chats)
# assistant = linked to a spare account that only the assistant uses
WA_MODE=self
WA_ANNOUNCE_GROUPS=false

# ---------- Desktop tools ----------
DESKTOP_CONTROL=false
DESKTOP_SCREENSHOTS=false
DESKTOP_SCREEN_MAX=1280

# ---------- Coffee / tea machine ----------
BREW_AUTONOMY=false

# ---------- Spotify ----------
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ---------- Samsung TV ----------
SAMSUNG_TV_HOST=
SAMSUNG_TV_MAC=

# ---------- MXW01 receipt printer ----------
MXW01_MAC=
MXW01_ROTATE=0
MXW01_INTENSITY=80
MXW01_THRESHOLD=180
MXW01_BOLD=false

# ---------- LiveKit phone line ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=jarvis
# Your LiveKit SIP number in E.164 format, e.g. +15550100000
JARVIS_NUMBER=
